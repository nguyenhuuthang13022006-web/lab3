@model BaiThucHanh2.Models.Student
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Create Student";
}
<h1 class="h3 mb-4">Create Student</h1>
<form asp-action="Create" method="post" class="student-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row align-items-center mb-2">
        <label asp-for="Name" class="col-md-2 col-form-label">Name</label>
        <div class="col-md-10">
            <input asp-for="Name" class="form-control" placeholder="Nhập họ tên" autofocus />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>
    <div class="row align-items-center mb-2">
        <label asp-for="Email" class="col-md-2 col-form-label">Email</label>
        <div class="col-md-10">
            <input asp-for="Email" type="email" class="form-control" placeholder="name@gmail.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </div>
    <div class="row align-items-center mb-2">
        <label asp-for="Password" class="col-md-2 col-form-label">Password</label>
        <div class="col-md-10">
            <input asp-for="Password" type="password" class="form-control" placeholder="Tối thiểu 8 ký tự" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
    </div>
    <div class="row align-items-center mb-2">
        <label asp-for="Branch" class="col-md-2 col-form-label">Branch</label>
        <div class="col-md-10">
            <select asp-for="Branch" asp-items="ViewBag.AllBranches" class="form-select branch-select">
                <option value="">-- Chọn ngành --</option>
            </select>
            <span asp-validation-for="Branch" class="text-danger"></span>
        </div>
    </div>
    <div class="row align-items-center mb-2">
        <label asp-for="IsRegular" class="col-md-2 col-form-label">IsRegular</label>
        <div class="col-md-10">
            <div class="form-check"><input asp-for="IsRegular" class="form-check-input" /></div>
        </div>
    </div>
    <div class="row align-items-center mb-2">
        <label asp-for="DateOfBirth" class="col-md-2 col-form-label">DateOfBirth</label>
        <div class="col-md-10">
            <input asp-for="DateOfBirth" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
        </div>
    </div>
    <div class="row align-items-center mb-2">
        <label asp-for="Gender" class="col-md-2 col-form-label">Gender</label>
        <div class="col-md-10">
            @foreach (var gender in (IEnumerable<SelectListItem>)ViewBag.AllGenders)
            {
                var radioId = "gender_" + gender.Value;
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="Gender" value="@gender.Value" id="@radioId" />
                    <label class="form-check-label" for="@radioId">@gender.Text</label>
                </div>
            }
            <div><span asp-validation-for="Gender" class="text-danger"></span></div>
        </div>
    </div>
    <div class="row align-items-center mb-2">
        <label asp-for="Score" class="col-md-2 col-form-label">Điểm</label>
        <div class="col-md-10">
            <input asp-for="Score" type="number" min="0" max="10" step="0.1" class="form-control" placeholder="Nhập điểm từ 0.0 đến 10.0" />
            <span asp-validation-for="Score" class="text-danger"></span>
        </div>
    </div>
    <div class="row align-items-start mb-3">
        <label asp-for="Address" class="col-md-2 col-form-label">Address</label>
        <div class="col-md-10">
            <textarea asp-for="Address" class="form-control" rows="3" placeholder="Nhập địa chỉ"></textarea>
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="offset-md-2 col-md-10">
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
